    "fattips-database": "workspace:^",
    "fattips-shared": "workspace:^",
    "fattips-solana": "workspace:^",
    "helmet": "^7.2.0",
    "ioredis": "^5.9.2",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "eslint": "^8.57.1",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3"
