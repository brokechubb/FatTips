{
  "name": "fattips-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for FatTips",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "start": "NODE_NO_WARNINGS=1 node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
