FROM node:22-alpine AS base

# Install dependencies and build tools for native modules (bigint-buffer, etc.)
RUN apk add --no-cache libc6-compat openssl python3 make g++

WORKDIR /app

# Copy source code first (filtered by .dockerignore — no .env, .git or backups)
COPY . .

# Install pnpm globally, then install exactly what the lockfile pins
RUN npm install -g pnpm@8.12.0 \
    && pnpm install --frozen-lockfile

# Build dependencies in correct order (database -> solana -> shared)
RUN pnpm --filter fattips-database generate \
    && pnpm --filter fattips-database build \
    && pnpm --filter fattips-solana build \
    && pnpm --filter fattips-shared build

# Build the application
RUN pnpm --filter fattips-bot build

# Production image
FROM node:22-alpine AS runner
RUN apk add --no-cache openssl

# Install pnpm for runtime scripts (migrations etc)
RUN npm install -g pnpm@8.12.0

WORKDIR /app

ENV NODE_ENV=production

# Copy everything from base to ensure all dependencies and symlinks are preserved
COPY --from=base /app .

# Don't run as root
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 -G nodejs botuser
USER botuser

EXPOSE 3000

# Update CMD to point to the correct path inside /app
# The directory structure is preserved inside the container (apps/bot)
CMD ["node", "apps/bot/dist/index.js"]
